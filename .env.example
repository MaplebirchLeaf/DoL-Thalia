# Copy this file to .env and replace the paths with your local JDK 17 and Android SDK locations.
# Bun loads the root .env automatically when running repository scripts.
JAVA_HOME=/absolute/path/to/jdk-17
ANDROID_HOME=/absolute/path/to/android-sdk
ANDROID_SDK_ROOT=/absolute/path/to/android-sdk

# Optional runtime proxy for browser-installable GitHub Release dependencies.
THALIA_MOD_PROXY_URL=https://your-worker.example.workers.dev/
