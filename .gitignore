# dependencies
node_modules/
__pycache__/
*.pyc

# machine-local environment
.env
.env.local
.env.*.local
!.env.example

# build outputs and caches
dist/
.cache/
temp/
publish/
site/public/play/

# local game/mod/signing inputs
input/*
!input/modList.json
!input/modList-dolp.json
!input/icon.png
!input/.gitkeep

# keep the input directory shape without committing large packages
!input/
input/game/*
!input/game/.gitkeep
!input/game-dolp/
input/game-dolp/*
!input/game-dolp/.gitkeep
!input/mods/
!input/mods/.gitkeep
input/mods/**/*

# DoLP variant local inputs (large packages, never committed)
input/mods-dolp/

!input/signing/
input/signing/*
!input/signing/.gitkeep

# local vendor checkouts
/vendor/*
!/vendor/sugarcube-2-ModLoader/

# system files
.DS_Store
LOCAL_BUILD.md
