{
  "name": "dol-thalia",
  "version": "1.0.0",
  "private": true,
  "description": "Custom APK / ZIP packaging toolkit for ModLoader-integrated Degrees of Lewdity builds.",
  "type": "module",
  "scripts": {
    "build:env": "bun run src/commands/prepare.ts sugarcube modloader story-format modloader-tools builtin-mods",
    "build:local": "bun run src/commands/build-local.ts --skip-prepare --fast",
    "build:html": "bun run src/commands/build-html.ts --skip-prepare",
    "build:zip": "bun run src/commands/build-release.ts --target=zip",
    "build:apk": "bun run src/commands/build-release.ts --target=apk",
    "build:all": "bun run src/commands/build-release.ts",
    "check": "tsc --noEmit && oxlint && oxfmt --check",
    "test": "bun test ./tests",
    "test:native": "bun run tests/run-native.ts",
    "test:runtime": "bun run src/commands/test-runtime.ts",
    "test:audit": "python3 -m unittest discover -s tests -p 'test_*.py'",
    "audit": "python3 tools/audit_release.py --dist dist",
    "site:dev": "vite --config site/vite.config.ts --host 127.0.0.1",
    "site:build": "bun run src/commands/site-build-data.ts && vite build --config site/vite.config.ts",
    "site:preview": "vite preview --config site/vite.config.ts --host 127.0.0.1",
    "fix": "oxlint --fix && oxfmt"
  },
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "cordova": "^13.0.0",
    "fflate": "^0.8.3",
    "vue": "^3.5.34"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@vitejs/plugin-vue": "^6.0.7",
    "oxfmt": "^0.35.0",
    "oxlint": "^1.50.0",
    "oxlint-tsgolint": "^0.14.2",
    "terser": "^5.47.1",
    "typescript": "7.0.2",
    "vite": "^8.0.14"
  },
  "packageManager": "bun@1.4.2"
}
