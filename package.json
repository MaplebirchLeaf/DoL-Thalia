{
  "name": "dol-thalia",
  "version": "0.1.0",
  "private": true,
  "description": "Custom APK / ZIP packaging toolkit for ModLoader-integrated Degrees of Lewdity builds.",
  "type": "module",
  "scripts": {
    "ts": "tsc --noEmit",
    "build": "bun run src/tasks/build.ts",
    "builtin-mods": "bun run src/tasks/builtin-mods.ts",
    "build:html": "bun run src/tasks/html.ts",
    "build:zip": "bun run src/tasks/zip.ts",
    "build:apk": "bun run src/tasks/apk.ts",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check"
  },
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "cordova": "^13.0.0",
    "fflate": "^0.8.3",
    "fs-extra": "^11.3.0"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "oxfmt": "^0.35.0",
    "oxlint": "^1.50.0",
    "oxlint-tsgolint": "^0.14.2",
    "terser": "^5.47.1",
    "typescript": "^6.0.3"
  },
  "packageManager": "bun@1.3.14"
}
